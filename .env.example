# Copy to .env.local (dev) or /etc/lottery/lottery.env (VM, loaded by systemd). See docs/supabase.md.

# Supabase Auth used for login (Kong gateway). On the VM use the loopback address.
SUPABASE_URL=http://127.0.0.1:18000
SUPABASE_ANON_KEY=

# Optional: only these emails may sign in (comma-separated). Empty = every Supabase Auth user.
LOTTERY_ALLOWED_EMAILS=

# Separate "lottery" database (login history + audit log). Optional; leave empty to disable logging.
# On the VM it is reached through the lottery-db-proxy container (127.0.0.1:25432 -> supabase-db:15432).
DATABASE_URL=postgres://lottery_app:PASSWORD@127.0.0.1:25432/lottery

# Folder with the effect*-2k*.mp4 clips.
MEDIA_DIR=/opt/lottery-media
